{
  "expo": {
    "name": "therapy",
    "slug": "therapy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logoColorida.webp",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logoColorida.webp",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": false,
      "package": "com.luucasalvess.therapy"
    },
    "backgroundColor": "#000000",
    "barStyle": "light-content",
    "extra": {
      "eas": {
        "projectId": "6862b7ce-c95a-4aa9-8693-29081c4481c1"
      }
    }
  },
  "web": {
    "favicon": "./assets/logoColorida.webp",
    "lang": "pt-BR"
  },
  "plugins": [
    "expo-font"
  ],
  "extra": {
    "eas": {
      "projectId": "6862b7ce-c95a-4aa9-8693-29081c4481c1"
    }
  }
}
